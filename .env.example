# PostgreSQL / Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-secret"

# Development seed user (never commit a real password)
SEED_USER_NAME="Your Name"
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD="change-me-before-use"
SEED_CHALLENGE_START_DATE="2026-09-20"

# Optional email automation (leave blank until Resend is configured)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Public application URL used in email links
APP_URL="http://localhost:3000"

# Required in production for the hourly cron endpoint
CRON_SECRET=""
