generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  COACH
}

enum SundayWalkingMode {
  WALK
  REST
}

enum TaskType {
  SLEEP
  DIET
  WATER
  WALKING
  WORKOUT
  CODING_BLOCK_1
  CODING_BLOCK_2
}

enum TaskStatus {
  COMPLETED
  PARTIAL
  MISSED
  PLANNED_REST
  NOT_APPLICABLE
}

enum DayType {
  TRAINING
  REST
  FULL_REST
}

enum TokenTransactionType {
  DAILY_REWARD
  MISSED_DAY_PENALTY
  MANUAL_ADJUSTMENT
  REFUND
}

enum EmailEventType {
  DAILY_REMINDER
  MISSED_DAY
  THIRTY_DAY_REPORT
  LEVEL_UP
  CERTIFICATE_UNLOCK
}

enum EmailEventStatus {
  PENDING
  SENT
  FAILED
}


model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  settings       UserSettings?
  dailyLogs      DailyLog[]
  tokenTransactions TokenTransaction[]
  progressReports ProgressReport[]
  emailLogs      EmailLog[]
  achievements   Achievement[]

  @@index([role])
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  timezone              String   @default("Asia/Dhaka")
  challengeStartDate    DateTime @db.Date
  walkingTargetSteps    Int      @default(4000)
  waterTargetMl         Int      @default(2500)
  sleepTargetHours      Decimal  @default(8) @db.Decimal(4, 2)
  reminderHour          Int      @default(21)
  emailDailyReminder    Boolean  @default(true)
  emailMissedDay        Boolean  @default(true)
  emailThirtyDayReport  Boolean  @default(true)
  emailLevelUp          Boolean  @default(true)
  emailCertificateUnlock Boolean @default(true)
  sundayWalkingMode     SundayWalkingMode @default(WALK)
  workoutSchedule       Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyLog {
  id                String    @id @default(cuid())
  userId            String
  date              DateTime  @db.Date
  dayType           DayType
  completionPercent Decimal   @default(0) @db.Decimal(5, 2)
  applicableTasks   Int       @default(0)
  completedTasks    Int       @default(0)
  partialTasks      Int       @default(0)
  missedTasks       Int       @default(0)
  finalizedAt       DateTime?
  tokensAwarded     Boolean   @default(false)
  penaltyApplied    Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks        DailyTask[]
  transactions TokenTransaction[]

  @@unique([userId, date])
  @@index([userId, date])
  @@index([userId, finalizedAt])
}

model DailyTask {
  id                 String     @id @default(cuid())
  dailyLogId         String
  type               TaskType
  status             TaskStatus @default(MISSED)
  numericValue       Decimal?   @db.Decimal(10, 2)
  targetValue        Decimal?   @db.Decimal(10, 2)
  targetUnit         String?
  targetSnapshot     Json?
  note               String?
  completedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  @@unique([dailyLogId, type])
  @@index([dailyLogId, status])
}

model TokenTransaction {
  id             String                @id @default(cuid())
  userId         String
  dailyLogId     String?
  amount         Int
  type           TokenTransactionType
  reason         String
  relatedDate    DateTime?             @db.Date
  idempotencyKey String                @unique
  createdAt      DateTime              @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyLog DailyLog? @relation(fields: [dailyLogId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, relatedDate])
  @@index([userId, type])
}

model ProgressReport {
  id          String   @id @default(cuid())
  userId      String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  reportType  String
  fileKey     String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart, periodEnd, reportType])
  @@index([userId, periodStart, periodEnd])
}

model EmailLog {
  id          String           @id @default(cuid())
  userId      String
  eventType   EmailEventType
  status      EmailEventStatus @default(PENDING)
  relatedDate DateTime?        @db.Date
  providerId  String?
  error       String?
  createdAt   DateTime         @default(now())
  sentAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eventType, relatedDate])
  @@index([status, createdAt])
  @@unique([userId, eventType, relatedDate])
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  unlockedAt  DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId, unlockedAt])
}
